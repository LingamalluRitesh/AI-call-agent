APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
INTERNAL_API_KEY=your-secret-api-key

# Neon PostgreSQL Cloud Database
NEON_DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# OpenAI Speech & Language Models
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TEXT_MODEL=gpt-4o

# ElevenLabs Cloned Voice Configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Storage & Retention
RECORDING_RETENTION_DAYS=30
LOCAL_DATA_DIR=./data
LOCAL_RECORDINGS_DIR=./data/recordings

# Exotel Telephony Configuration
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=
EXOTEL_WEBHOOK_SECRET=

# Owner & Receptionist Profile
OWNER_DISPLAY_NAME=Ritesh
DEFAULT_GREETING_LANGUAGE=auto
CALL_RECORDING_ENABLED=true
RECORDING_REQUIRES_AFFIRMATIVE_CONSENT=true

# Android Push Notifications (Firebase)
FCM_SERVER_KEY=
RITESH_ANDROID_FCM_TOKEN=
